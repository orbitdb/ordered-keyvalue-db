{
  "name": "@orbitdb/ordered-keyvalue-db",
  "version": "2.0.1",
  "description": "Ordered keyvalue database type for orbit-db.",
  "author": "Julien Jean Malard-Adam",
  "keywords": [
    "orbitdb"
  ],
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "compile": "pnpm clean && pnpm tsc -p tsconfig.json",
    "compile:prod": "pnpm updateVersion && pnpm clean && pnpm tsc -p tsconfig.build.json",
    "test": "pnpm test:node && pnpm test:browser",
    "test:node": "pnpm compile && pnpm aegir test -t node --cov -- --exit",
    "test:browser": "pnpm compile && pnpm aegir test -t browser --cov -- --exit",
    "format": "pnpm prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\" && pnpm eslint",
    "release": "pnpm test && pnpm compile:prod && (git commit -a -m 'version' || true) && pnpm stage publish",
    "updateVersion": "pnpm genversion  --es6 --semi src/version.ts"
  },
  "dependencies": {
    "@orbitdb/core": "^4.0.0",
    "helia": "^7.1.16",
    "it-all": "^3.0.11",
    "tiny-typed-emitter": "^2.1.0"
  },
  "devDependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@helia/libp2p": "^2.1.5",
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/gossipsub": "^17.1.2",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/interface": "^3.3.0",
    "@libp2p/webrtc": "^6.0.33",
    "@libp2p/websockets": "^10.1.21",
    "@orbitdb/core-types": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "aegir": "^48.1.6",
    "blockstore-core": "^7.0.1",
    "blockstore-level": "^4.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "genversion": "^3.2.0",
    "libp2p": "^3.3.11",
    "mocha": "^11.8.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "wherearewe": "^2.0.1"
  }
}
